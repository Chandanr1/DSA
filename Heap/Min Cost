class Solution {
    public static int minCost(int[] arr) {
        // code here
         PriorityQueue<Integer> pq = new PriorityQueue<>();
         for(int ele:arr){
             pq.add(ele);
         }
         int sum=0;
         while(pq.size()>1){
             int x=pq.remove();
             int y=pq.remove();
             sum+=x+y;
             pq.add(x+y);
         }
         return sum;
    }
}
