class Solution {
    public static boolean areAnagrams(String s1, String s2) {
        // code here
        HashMap<Character , Integer> a1 = new HashMap<>();
        for(int i=0 ;i<s1.length();i++){
            char ch=s1.charAt(i);
            if(a1.containsKey(ch)){
                int freq=a1.get(ch);
                a1.put(ch,freq+1);
            }
            else a1.put(ch,1);
        }
        for(int i=0 ;i<s2.length();i++){
            char ch=s2.charAt(i);
            if(a1.containsKey(ch)){
                int freq=a1.get(ch);
                a1.put(ch,freq+1);
            }
            else a1.put(ch,1);
        }
        for(char ch : a1.keySet()){
            int freq=a1.get(ch);
            if(freq%2!=0) return false;
        }
        return true;
    }
}
