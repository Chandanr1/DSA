class Solution {
    public int equalPairs(String s) {
        // code here
        HashMap<Character ,Integer> map= new HashMap<>();
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            if(!map.containsKey(ch)) map.put(ch,1);
            else map.put(ch,map.get(ch)+1);
        }
        int pairs=0;
        for(char ch:map.keySet()){
            int freq=map.get(ch);
            pairs+=freq*freq;
        }
        return pairs;
    }
}
