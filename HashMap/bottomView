class pair{
    Node temp;
    int dist;
    pair(Node temp,int dist){
        this.temp=temp;
        this.dist=dist;
    }
}
class Solution {
    public ArrayList<Integer> bottomView(Node root) {
        
        HashMap<Integer,Integer> map = new HashMap<>();
        Queue<pair> q = new LinkedList<>();
        ArrayList<Integer> arr = new ArrayList<>();
        q.add(new pair(root,0));
        int min=Integer.MAX_VALUE ; 
        int max = Integer.MIN_VALUE;
        while(q.size()>0){
            pair front = q.remove();
            Node top = front.temp;
            int dist = front.dist;
            min=Math.min(dist,min);
            max=Math.max(dist,max);
             map.put(dist,top.data);
            if(top.left!=null) q.add(new pair(top.left,dist-1));
            if(top.right!=null) q.add(new pair(top.right,dist+1));
        }
        
        for(int i=min;i<=max;i++){
            arr.add(map.get(i));
        }
        return arr;
    }
}
