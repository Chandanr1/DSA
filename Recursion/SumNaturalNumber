import java.util.Scanner;

class SumNaturalNumber {
    public static int sum(int n){
        if(n==0) return 0;
        if(n==1) return 1;
        return n+sum(n-1);
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
       
        // code here
        System.out.print(sum(n));
    }
}
